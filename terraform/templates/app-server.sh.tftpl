#!/usr/bin/env bash
# Bootstrap one private Shopfront application host.
set -euo pipefail

exec > >(tee -a /var/log/nightshift-bootstrap.log) 2>&1
export DEBIAN_FRONTEND=noninteractive
hostnamectl set-hostname '${hostname}'

for i in 1 2 3 4 5; do
  apt-get update -y && break
  sleep 10
done
apt-get install -y curl unzip jq git ca-certificates python3 python3-venv

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi

# StrongDM owns the private key. Install only its generated public half.
SDM_PUBKEY='${sdm_public_key}'
AUTH_KEYS=/home/ubuntu/.ssh/authorized_keys
install -d -m 0700 -o ubuntu -g ubuntu /home/ubuntu/.ssh
touch "$AUTH_KEYS"
if ! grep -qF "$SDM_PUBKEY" "$AUTH_KEYS"; then
  printf '\n# StrongDM-managed key for ${hostname}\n%s\n' "$SDM_PUBKEY" >>"$AUTH_KEYS"
fi
chown ubuntu:ubuntu "$AUTH_KEYS"
chmod 0600 "$AUTH_KEYS"

# Pull the exact repository ref used by the demo. This keeps user-data below
# AWS's 16 KiB limit while preserving a reproducible source revision.
rm -rf /opt/nightshift-source
git clone --depth 1 --branch '${nightshift_repo_ref}' \
  '${nightshift_repo_url}' /opt/nightshift-source

if ! id orders >/dev/null 2>&1; then
  useradd --system --create-home --home-dir /opt/orders-api --shell /usr/sbin/nologin orders
fi
install -d -m 0755 -o orders -g orders /opt/orders-api
cp -a /opt/nightshift-source/app/orders-api/. /opt/orders-api/
chown -R orders:orders /opt/orders-api

python3 -m venv /opt/orders-api/venv
/opt/orders-api/venv/bin/pip install --quiet --upgrade pip
/opt/orders-api/venv/bin/pip install --quiet -r /opt/orders-api/requirements.txt
chown -R orders:orders /opt/orders-api/venv

# Application database credentials remain on the application host, not the
# agent host. The instance role can read only this one secret.
DB_SECRET_JSON="$(aws secretsmanager get-secret-value \
  --region '${aws_region}' \
  --secret-id '${db_secret_arn}' \
  --query SecretString --output text)"
DB_USER="$(printf '%s' "$DB_SECRET_JSON" | jq -r '.username')"
DB_PASS="$(printf '%s' "$DB_SECRET_JSON" | jq -rj '.password' | jq -sRr @uri)"

umask 077
cat >/etc/orders-api.env <<EOF
SHOPFRONT_URL=postgresql://$DB_USER:$DB_PASS@${db_host}:5432/${db_name}?sslmode=require
ORDERS_API_HOST=0.0.0.0
ORDERS_API_PORT=${app_listen_port}
ORDERS_API_POOL_MIN=1
ORDERS_API_POOL_MAX=8
AWS_REGION=${aws_region}
EOF
chown root:orders /etc/orders-api.env
chmod 0640 /etc/orders-api.env
unset DB_SECRET_JSON DB_USER DB_PASS
umask 022

cp /opt/orders-api/orders-api.service /etc/systemd/system/orders-api.service
sed -i 's/--port [0-9][0-9]*/--port ${app_listen_port}/' /etc/systemd/system/orders-api.service

# Prometheus agent scrapes the service and remote-writes to Grafana Cloud.
if ! id prometheus >/dev/null 2>&1; then
  useradd --system --no-create-home --shell /usr/sbin/nologin prometheus
fi
install -d -m 0750 -o prometheus -g prometheus /etc/prometheus-agent /var/lib/prometheus-agent

PROM_VER='${prometheus_version}'
PROM_DIR="prometheus-$PROM_VER.linux-amd64"
curl -fsSL "https://github.com/prometheus/prometheus/releases/download/v$PROM_VER/$PROM_DIR.tar.gz" \
  -o /tmp/prometheus.tar.gz
tar -xzf /tmp/prometheus.tar.gz -C /tmp
install -m 0755 "/tmp/$PROM_DIR/prometheus" /usr/local/bin/prometheus
rm -rf "/tmp/$PROM_DIR" /tmp/prometheus.tar.gz

RW_PASSWORD="$(aws ssm get-parameter \
  --region '${aws_region}' \
  --name '${metrics_write_token_ssm_path}' \
  --with-decryption --query Parameter.Value --output text)"
umask 077
printf '%s' "$RW_PASSWORD" >/etc/prometheus-agent/remote-write-password
chown prometheus:prometheus /etc/prometheus-agent/remote-write-password
chmod 0600 /etc/prometheus-agent/remote-write-password
unset RW_PASSWORD
umask 022

cat >/etc/prometheus-agent/prometheus.yml <<'EOF'
global:
  scrape_interval: ${prometheus_scrape_interval}
  scrape_timeout: 5s
  external_labels:
    env: prod
    project: nightshift
    host: ${hostname}
scrape_configs:
  - job_name: orders-api
    metrics_path: /metrics
    static_configs:
      - targets: ['127.0.0.1:${app_listen_port}']
        labels:
          instance: ${hostname}
remote_write:
  - url: ${remote_write_url}
    basic_auth:
      username: '${remote_write_username}'
      password_file: /etc/prometheus-agent/remote-write-password
    write_relabel_configs:
      - source_labels: [__name__]
        regex: '(http_requests_.*|http_5xx_ratio|orders_.*|orders_api_.*|up|scrape_samples_scraped)'
        action: keep
EOF
chown prometheus:prometheus /etc/prometheus-agent/prometheus.yml
chmod 0640 /etc/prometheus-agent/prometheus.yml

cat >/etc/systemd/system/prometheus-agent.service <<'EOF'
[Unit]
Description=Prometheus agent for orders-api
After=network-online.target orders-api.service
Wants=network-online.target

[Service]
Type=exec
User=prometheus
Group=prometheus
ExecStart=/usr/local/bin/prometheus --agent --config.file=/etc/prometheus-agent/prometheus.yml --storage.agent.path=/var/lib/prometheus-agent --web.listen-address=127.0.0.1:9090 --log.level=info
Restart=always
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prometheus-agent

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now orders-api.service
systemctl enable --now prometheus-agent.service

sleep 5
curl -fsS "http://127.0.0.1:${app_listen_port}/health" || true
echo "=== ${hostname} bootstrap complete $(date -Is) ==="
