# Copy to scripts/.env. This file is sourced by the operator scripts.
#
# NON-SECRET CONFIGURATION ONLY. Every credential now arrives from 1Password
# via `./scripts/secrets.sh exec -- …`, and load_env in common.sh lets the
# environment win over this file, so a leftover placeholder here can no longer
# clobber an injected value. Run the demo scripts through secrets.sh:
#
#     ./scripts/secrets.sh exec -- ./scripts/live-demo.sh start

# Human StrongDM connection opened locally with:
#   sdm connect pg-prod-shopfront-read 5433
SHOPFRONT_ADMIN_URL="postgresql://127.0.0.1:5433/shopfront"

# Read from /etc/nightshift.env on the agent VM after Terraform apply. This one
# is an OUTPUT of the build, not an input: agent/bootstrap.sh generates it on the
# VM, so there is nothing to mint. It is regenerated on every rebuild.
NIGHTSHIFT_SHIM_URL="http://127.0.0.1:18791"
NIGHTSHIFT_SHIM_TOKEN="REPLACE_WITH_SHIM_TOKEN"
NIGHTSHIFT_SESSION="oncall"

# StrongDM SSH resource used for operator control. The config file is generated
# by `sdm ssh config`; no EC2 private key is required.
AGENT_SSH_RESOURCE="agent-vm"
AGENT_HOME="/home/ubuntu"
PICOCLAW_HOME="/home/ubuntu/.picoclaw"
AGENT_WORKSPACE="/opt/nightshift/workspace"

# StrongDM resource names and fixed agent-side ports.
PG_READ_RESOURCE="pg-prod-shopfront-read"
PG_REMEDIATION_RESOURCE="pg-prod-shopfront-remediation"
PG_REMEDIATION_PORT="5434"
GRAFANA_MCP_PORT="13001"
GITHUB_MCP_PORT="13002"

# Grafana stack. The URL and slug are not secrets; GRAFANA_SA_TOKEN is injected
# from the vault (secrets/nightshift.env.tpl) and must NOT be set here.
# secrets.sh derives the slug from GRAFANA_URL when GRAFANA_STACK_SLUG is unset.
GRAFANA_URL="https://nightshift.grafana.net"
GRAFANA_STACK_SLUG="nightshift"

# Disposable repository. GITHUB_TOKEN is NOT set here: `secrets.sh exec` mints a
# read-only 60-minute GitHub App installation token for preflight on every run.
GITHUB_REPO="your-org/shopfront-platform"
