# /etc/orders-api.env — copy, fill in, chmod 0640 root:orders
#
# These credentials live on app-01/app-02 (the application's own hosts).
# They must NEVER appear on the agent VM. If you find a PGPASSWORD on the
# agent VM during Run 2, the demo is broken — that is the entire claim.

# Full DSN wins if set. RDS endpoint from `terraform output shopfront_endpoint`.
SHOPFRONT_URL=postgresql://orders_api:REPLACE_ME@shopfront-db.abc123.eu-west-1.rds.amazonaws.com:5432/shopfront?sslmode=require

# ...or the individual libpq variables instead of SHOPFRONT_URL:
# PGHOST=shopfront-db.abc123.eu-west-1.rds.amazonaws.com
# PGPORT=5432
# PGDATABASE=shopfront
# PGUSER=orders_api
# PGPASSWORD=REPLACE_ME
# PGSSLMODE=require

ORDERS_API_HOST=0.0.0.0
ORDERS_API_PORT=8080
ORDERS_API_POOL_MIN=1
ORDERS_API_POOL_MAX=8
