slides/node_modules/
# Blanket-ignored on purpose: anything resolved, dumped or exported into this
# directory stays untracked. The op:// reference templates are the exception —
# they contain pointers, not values, and are the source of truth for
# scripts/secrets.sh.
secrets/*
!secrets/*.tpl
